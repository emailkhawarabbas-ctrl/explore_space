{
  "paths": {
    "input_dir": "videos",
    "output_dir": "output",
    "music_dir": "music",
    "temp_dir": null,
    "log_file": "render.log"
  },

  "input": {
    "extensions": [".mp4", ".mov", ".mkv", ".webm"],
    "deep_validate": true,
    "on_bad_clip": "skip",
    "min_clip_duration": 0.5
  },

  "output": {
    "filename": "final_video.mp4",
    "overwrite": true,
    "resolution": "auto",
    "fps": "auto",
    "fit_mode": "pad",
    "video_codec": "libx264",
    "crf": 18,
    "preset": "slow",
    "pix_fmt": "yuv420p",
    "audio_codec": "aac",
    "audio_bitrate": "256k",
    "audio_sample_rate": 48000
  },

  "transitions": {
    "enabled": true,
    "mode": "auto",
    "duration": 0.8,
    "fixed_type": "fade",
    "allowed": ["fade", "fadeblack", "dissolve", "fadegrays"],
    "allow_cuts": true,
    "analysis": {
      "cut_threshold": 0.05,
      "similar_threshold": 0.20,
      "different_threshold": 0.45,
      "luma_jump_threshold": 0.25,
      "motion_threshold": 0.10,
      "motion_duration_factor": 0.6,
      "max_fraction_of_clip": 0.45
    },
    "overrides": {}
  },

  "color_correction": {
    "enabled": true,
    "match_clips": true,
    "strength": 0.6,
    "look": "neutral"
  },

  "audio": {
    "keep_original": true,
    "original_volume": 1.0,
    "normalize_clips": true,
    "highpass_hz": 60,
    "denoise": false,
    "fade_in": 1.0,
    "fade_out": 2.0,
    "final_loudnorm": true,
    "final_lufs": -16
  },

  "music": {
    "enabled": true,
    "file": null,
    "volume": 0.18,
    "ducking": true,
    "loop": true,
    "fade_in": 2.0,
    "fade_out": 3.0,
    "extensions": [".mp3", ".wav", ".m4a", ".aac", ".flac", ".ogg", ".opus"]
  },

  "fades": {
    "enabled": true,
    "video_fade_in": 1.0,
    "video_fade_out": 1.5
  },

  "intro_outro": {
    "intro": { "enabled": false, "file": "intro_outro/intro.mp4" },
    "outro": { "enabled": false, "file": "intro_outro/outro.mp4" },
    "transition": "fadeblack",
    "duration": 1.0
  },

  "titles": {
    "font_file": null,
    "title": {
      "enabled": false,
      "text": "My Film Title",
      "start": 1.0,
      "duration": 4.0,
      "fade": 0.8,
      "fontsize_ratio": 0.07,
      "color": "white",
      "position": "center"
    },
    "credits": {
      "enabled": false,
      "lines": ["Created with Google Flow", "Edited automatically with FFmpeg"],
      "duration": 6.0,
      "fontsize_ratio": 0.045,
      "color": "white"
    }
  },

  "performance": {
    "max_clips_per_pass": 10,
    "threads": 0,
    "intermediate_crf": 12,
    "intermediate_preset": "veryfast"
  }
}
